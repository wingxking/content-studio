{
  "name": "content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "studio": "node --import tsx src/server/cli.ts",
    "doctor": "node --import tsx src/server/cli.ts doctor",
    "test:http": "node --import tsx tests/http-smoke.ts",
    "local:setup": "node scripts/local.mjs setup",
    "local:start": "node scripts/local.mjs start",
    "local:stop": "node scripts/local.mjs stop",
    "local:status": "node scripts/local.mjs status",
    "local:backup": "node scripts/local.mjs backup",
    "local:restore": "node scripts/local.mjs restore",
    "local:upgrade": "node scripts/local.mjs upgrade",
    "worker": "node --import tsx src/server/worker.ts",
    "docker:capture": "node scripts/docker.mjs capture",
    "docker:start": "node scripts/docker.mjs start",
    "docker:stop": "node scripts/docker.mjs stop",
    "docker:status": "node scripts/docker.mjs status",
    "docker:migrate": "node scripts/docker.mjs migrate",
    "docker:backup": "node scripts/docker.mjs backup",
    "docker:restore": "node scripts/docker.mjs restore"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tus/file-store": "2.1.1",
    "@tus/server": "2.4.5",
    "@uppy/core": "6.2.0",
    "@uppy/tus": "6.0.0",
    "express": "^5.3.0",
    "fast-xml-parser": "5.11.2",
    "linkedom": "^0.18.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "4.0.1",
    "remark-stringify": "11.0.0",
    "sharp": "0.35.5",
    "twitter-text": "^3.1.0",
    "unified": "11.0.5",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/twitter-text": "^3.1.10",
    "@types/ws": "8.18.2",
    "pg-boss": "12.37.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}

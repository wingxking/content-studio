{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "chrome", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@wechatsync/core": ["core/src"],
      "@wechatsync/core/*": ["core/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "core/src/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "core/src/**/__tests__/**"]
}

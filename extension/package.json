{
  "name": "content-studio-extension",
  "version": "2.0.13",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/verify-build.mjs",
    "test": "vitest run",
    "verify": "npm run test && npm run build",
    "package": "npm run build && node scripts/package.mjs",
    "restore:client-config": "node scripts/restore-client-config.mjs",
    "dev": "vite build --watch --mode development",
    "test:integration": "tsc --noEmit -p tsconfig.integration.json && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@modyfi/vite-plugin-yaml": "1.1.1",
    "clsx": "2.1.1",
    "defuddle": "0.14.0",
    "hast-util-to-string": "3.0.1",
    "js-md5": "0.8.3",
    "jszip": "3.10.1",
    "juice": "11.1.0",
    "linkedom": "0.18.12",
    "lucide-react": "0.303.0",
    "markdown-draft-js": "2.4.0",
    "marked": "17.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.12.0",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "remarkable": "2.0.1",
    "tailwind-merge": "2.6.0",
    "turndown": "7.2.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "yaml": "2.8.2",
    "zod": "3.25.76",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.3.0",
    "@types/chrome": "0.0.254",
    "@types/node": "22.19.7",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/remarkable": "2.0.8",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.23",
    "postcss": "8.5.6",
    "prettier": "3.7.4",
    "tailwindcss": "3.4.19",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}

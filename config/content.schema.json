{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brief": {
      "type": "object",
      "properties": {
        "topicOrigin": {
          "type": "string",
          "enum": [
            "editorial",
            "trend"
          ]
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "angle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sources": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "excerpt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000
              }
            },
            "required": [
              "title",
              "url",
              "excerpt"
            ],
            "additionalProperties": false
          }
        },
        "platforms": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "xiaohongshu",
              "reddit",
              "x",
              "wechat",
              "tiktok",
              "bilibili",
              "youtube",
              "kuaishou",
              "douyin",
              "instagram",
              "linkedin",
              "facebook",
              "producthunt",
              "zhihu"
            ]
          }
        }
      },
      "required": [
        "topic",
        "audience",
        "angle",
        "sources",
        "platforms"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80000
        },
        "document": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "content": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "schemaVersion",
            "content"
          ],
          "additionalProperties": false
        },
        "variants": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string",
                "enum": [
                  "xiaohongshu",
                  "reddit",
                  "x",
                  "wechat",
                  "tiktok",
                  "bilibili",
                  "youtube",
                  "kuaishou",
                  "douyin",
                  "instagram",
                  "linkedin",
                  "facebook",
                  "producthunt",
                  "zhihu"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60000
              },
              "tags": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              },
              "mediaPaths": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "format": {
                "type": "string",
                "enum": [
                  "text",
                  "article",
                  "image_note",
                  "video",
                  "product_launch"
                ]
              },
              "launch": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "tagline": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 260
                  },
                  "firstComment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                },
                "required": [
                  "url",
                  "name",
                  "tagline",
                  "description",
                  "firstComment"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "platform",
              "title",
              "text",
              "tags",
              "mediaPaths"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "body",
        "variants"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "brief",
    "content"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "doc",
            "paragraph",
            "heading",
            "text",
            "bulletList",
            "orderedList",
            "listItem",
            "blockquote",
            "codeBlock",
            "hardBreak",
            "horizontalRule",
            "image",
            "citation"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 80000
        },
        "attrs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 12000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "marks": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "bold",
                  "italic",
                  "strike",
                  "code",
                  "link"
                ]
              },
              "attrs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 12000
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "content": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
